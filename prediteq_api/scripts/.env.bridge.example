MACHINE_ID=ARO-01

PUBLISH_TRANSPORT=mqtt

# Public app URLs:
# frontend preferred = https://prediteq.aro-teq.com
# frontend fallback  = https://prediteq-saas.vercel.app
# backend public     = https://prediteq-saas.onrender.com

MQTT_HOST=your-private-broker
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_USE_SSL=true
MQTT_TOPIC=prediteq/{machine_id}/sensors

HTTP_INGEST_URL=https://prediteq-saas.onrender.com/ingest/live
HTTP_INGEST_TOKEN=
HTTP_INGEST_TIMEOUT_S=10.0

PUBLISH_INTERVAL_S=1.0
SOURCE_MODE=mock
SOURCE_JSON_PATH=
SOURCE_CSV_PATH=
SOURCE_LABEL=site_bridge_pc
