# -- Supabase (required) --
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# -- AI - Chat, Planner, Reports (Groq LLM) --
GROQ_API_KEY=gsk_...

# -- Email alerts via EmailJS HTTPS API (no phone required, easiest fallback) --
EMAILJS_API_BASE=https://api.emailjs.com
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=default_service
EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# -- Email alerts via Brevo HTTPS API (recommended on Render Free if you complete signup) --
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=PrediTeq Alerts
ADMIN_EMAIL=your-email@example.com

# -- Optional SMTP fallback (useful outside Render Free) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=PrediTeq Alerts <your-email@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# -- MQTT (optional - leave empty for simulated mode) --
MQTT_BROKER=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_USE_SSL=true
MQTT_ALLOW_PUBLIC_TEST_BROKER=false

# -- CORS (comma-separated origins) --
# For local dev, add: http://localhost:8080
CORS_ORIGINS=https://prediteq-saas.vercel.app

# -- Frontend URL (used in email links) --
DASHBOARD_URL=https://prediteq-saas.vercel.app

# -- ML directory (auto-detected locally, set on Render if needed) --
# ML_DIR=/opt/render/project/src/prediteq_ml
